(export (version "E")
  (design (source "demo_board.kicad_sch") (tool "make_demo_board.py"))
  (components
    (comp (ref "U1") (value "AP2112K-3.3") (libsource (lib "Regulator_Linear") (part "AP2112K-3.3") (description "600mA LDO, 3.3V fixed output")))
    (comp (ref "U2") (value "ATmega328P-AU") (libsource (lib "MCU_Microchip_ATmega") (part "ATmega328P-A") (description "8-bit AVR MCU, TQFP-32")))
    (comp (ref "U3") (value "BME280") (libsource (lib "Sensor") (part "BME280") (description "Pressure/humidity/temperature sensor, 1.71-3.6V")))
    (comp (ref "C1") (value "1uF 10V") (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "C2") (value "100nF 10V") (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "C3") (value "100nF 10V") (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "C4") (value "100nF 10V") (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "R1") (value "10k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2") (value "4.7k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R3") (value "4.7k") (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "D1") (value "LED_Green") (libsource (lib "Device") (part "LED") (description "Light emitting diode")))
    (comp (ref "Y1") (value "16MHz") (libsource (lib "Device") (part "Crystal") (description "Two pin crystal")))
    (comp (ref "J1") (value "Conn_01x02") (libsource (lib "Connector") (part "Conn_01x02") (description "5V input")))
  )
  (libparts
    (libpart (lib "Regulator_Linear") (part "AP2112K-3.3") (pins (pin (num "1") (name "VIN") (type "power_in")) (pin (num "2") (name "GND") (type "power_in")) (pin (num "3") (name "EN") (type "input")) (pin (num "4") (name "NC") (type "no_connect")) (pin (num "5") (name "VOUT") (type "power_out"))))
    (libpart (lib "MCU_Microchip_ATmega") (part "ATmega328P-A") (pins (pin (num "4") (name "VCC") (type "power_in")) (pin (num "6") (name "VCC") (type "power_in")) (pin (num "18") (name "AVCC") (type "power_in")) (pin (num "20") (name "AREF") (type "passive")) (pin (num "3") (name "GND") (type "power_in")) (pin (num "5") (name "GND") (type "power_in")) (pin (num "21") (name "GND") (type "power_in")) (pin (num "29") (name "~{RESET}/PC6") (type "input")) (pin (num "7") (name "XTAL1/PB6") (type "input")) (pin (num "8") (name "XTAL2/PB7") (type "output")) (pin (num "17") (name "PB5") (type "bidirectional")) (pin (num "27") (name "PC4/SDA") (type "bidirectional")) (pin (num "28") (name "PC5/SCL") (type "bidirectional"))))
    (libpart (lib "Sensor") (part "BME280") (pins (pin (num "8") (name "VDD") (type "power_in")) (pin (num "6") (name "VDDIO") (type "power_in")) (pin (num "1") (name "GND") (type "power_in")) (pin (num "7") (name "GND") (type "power_in")) (pin (num "2") (name "CSB") (type "input")) (pin (num "3") (name "SDI") (type "bidirectional")) (pin (num "4") (name "SCK") (type "input")) (pin (num "5") (name "SDO") (type "bidirectional"))))
    (libpart (lib "Device") (part "C") (pins (pin (num "1") (name "~") (type "passive")) (pin (num "2") (name "~") (type "passive"))))
    (libpart (lib "Device") (part "R") (pins (pin (num "1") (name "~") (type "passive")) (pin (num "2") (name "~") (type "passive"))))
    (libpart (lib "Device") (part "LED") (pins (pin (num "1") (name "K") (type "passive")) (pin (num "2") (name "A") (type "passive"))))
    (libpart (lib "Device") (part "Crystal") (pins (pin (num "1") (name "1") (type "passive")) (pin (num "2") (name "2") (type "passive"))))
    (libpart (lib "Connector") (part "Conn_01x02") (pins (pin (num "1") (name "Pin_1") (type "passive")) (pin (num "2") (name "Pin_2") (type "passive"))))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref "J1") (pin "1") (pinfunction "Pin_1") (pintype "passive"))
      (node (ref "U1") (pin "1") (pinfunction "VIN") (pintype "power_in"))
      (node (ref "U1") (pin "3") (pinfunction "EN") (pintype "input"))
      (node (ref "R2") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "R3") (pin "1") (pinfunction "~") (pintype "passive"))
    )
    (net (code "2") (name "+3V3")
      (node (ref "U1") (pin "5") (pinfunction "VOUT") (pintype "power_out"))
      (node (ref "C1") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "U2") (pin "4") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "U2") (pin "6") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "C2") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "U3") (pin "8") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "U3") (pin "6") (pinfunction "VDDIO") (pintype "power_in"))
      (node (ref "C3") (pin "1") (pinfunction "~") (pintype "passive"))
      (node (ref "R1") (pin "1") (pinfunction "~") (pintype "passive"))
    )
    (net (code "3") (name "GND")
      (node (ref "J1") (pin "2") (pinfunction "Pin_2") (pintype "passive"))
      (node (ref "U1") (pin "2") (pinfunction "GND") (pintype "power_in"))
      (node (ref "C1") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C2") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C3") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "C4") (pin "2") (pinfunction "~") (pintype "passive"))
      (node (ref "U2") (pin "3") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U2") (pin "5") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U2") (pin "21") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U3") (pin "1") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U3") (pin "7") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U3") (pin "5") (pinfunction "SDO") (pintype "bidirectional"))
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
    )
    (net (code "4") (name "/RESET")
      (node (ref "U2") (pin "29") (pinfunction "~{RESET}/PC6") (pintype "input"))
      (node (ref "R1") (pin "2") (pinfunction "~") (pintype "passive"))
    )
    (net (code "5") (name "/SDA")
      (node (ref "U2") (pin "27") (pinfunction "PC4/SDA") (pintype "bidirectional"))
      (node (ref "U3") (pin "3") (pinfunction "SDI") (pintype "bidirectional"))
      (node (ref "R2") (pin "2") (pinfunction "~") (pintype "passive"))
    )
    (net (code "6") (name "/SCL")
      (node (ref "U2") (pin "28") (pinfunction "PC5/SCL") (pintype "bidirectional"))
      (node (ref "U3") (pin "4") (pinfunction "SCK") (pintype "input"))
      (node (ref "R3") (pin "2") (pinfunction "~") (pintype "passive"))
    )
    (net (code "7") (name "/LED")
      (node (ref "U2") (pin "17") (pinfunction "PB5") (pintype "bidirectional"))
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive"))
    )
    (net (code "8") (name "/XTAL1")
      (node (ref "U2") (pin "7") (pinfunction "XTAL1/PB6") (pintype "input"))
      (node (ref "Y1") (pin "1") (pinfunction "1") (pintype "passive"))
    )
    (net (code "9") (name "/XTAL2")
      (node (ref "U2") (pin "8") (pinfunction "XTAL2/PB7") (pintype "output"))
      (node (ref "Y1") (pin "2") (pinfunction "2") (pintype "passive"))
    )
    (net (code "10") (name "/AREF")
      (node (ref "U2") (pin "20") (pinfunction "AREF") (pintype "passive"))
      (node (ref "C4") (pin "1") (pinfunction "~") (pintype "passive"))
    )
    (net (code "11") (name "unconnected-(U1-Pad4)")
      (node (ref "U1") (pin "4") (pinfunction "NC") (pintype "passive+no_connect")))
    (net (code "12") (name "unconnected-(U2-Pad18)")
      (node (ref "U2") (pin "18") (pinfunction "AVCC") (pintype "power_in")))
    (net (code "13") (name "unconnected-(U3-Pad2)")
      (node (ref "U3") (pin "2") (pinfunction "CSB") (pintype "input")))
  )
)
